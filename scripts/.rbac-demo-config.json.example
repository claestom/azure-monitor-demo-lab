{
  "_comment": "SHAPE-ONLY EXAMPLE. The real scripts/.rbac-demo-config.json is generated by scripts/setup-rbac-demo.ps1, contains live service principal secrets, and is gitignored. Do NOT commit a populated copy of this file.",
  "tenantId": "<YOUR-TENANT-ID>",
  "workspaceId": "<LAW-CUSTOMER-ID-GUID>",
  "workspaceResourceId": "/subscriptions/<YOUR-SUBSCRIPTION-ID>/resourceGroups/<YOUR-RG>/providers/Microsoft.OperationalInsights/workspaces/law-<namePrefix>-central",
  "servicePrincipals": {
    "workspace": {
      "displayName": "<namePrefix>-rbac-sp-workspace",
      "appId":       "<APP-ID-GUID>",
      "secret":      "<CLIENT-SECRET>",
      "spObjectId":  "<SP-OBJECT-ID-GUID>"
    },
    "row": {
      "displayName": "<namePrefix>-rbac-sp-row",
      "appId":       "<APP-ID-GUID>",
      "secret":      "<CLIENT-SECRET>",
      "spObjectId":  "<SP-OBJECT-ID-GUID>"
    },
    "table": {
      "displayName": "<namePrefix>-rbac-sp-table",
      "appId":       "<APP-ID-GUID>",
      "secret":      "<CLIENT-SECRET>",
      "spObjectId":  "<SP-OBJECT-ID-GUID>"
    }
  }
}
