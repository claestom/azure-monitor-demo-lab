{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "13713568238219540609"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "amlab",
      "minLength": 3,
      "maxLength": 8,
      "metadata": {
        "description": "Short prefix used to build resource names."
      }
    },
    "ownerTag": {
      "type": "string",
      "defaultValue": "demo-lab",
      "metadata": {
        "description": "Tag every resource with this owner."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id)]",
    "lawCentralName": "[format('law-{0}-central-{1}', parameters('namePrefix'), take(variables('suffix'), 5))]",
    "actionGroupName": "[format('ag-{0}-email', parameters('namePrefix'))]",
    "securityWorkbookName": "[format('wb-{0}-security', parameters('namePrefix'))]",
    "commonTags": {
      "owner": "[parameters('ownerTag')]",
      "purpose": "azure-monitor-demo-lab",
      "costCenter": "demo"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "law-rbac",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "centralLawId": {
            "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('lawCentralName'))]"
          },
          "centralLawName": {
            "value": "[variables('lawCentralName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('commonTags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "8545516125681944633"
            }
          },
          "parameters": {
            "centralLawId": {
              "type": "string",
              "metadata": {
                "description": "Central LAW resource ID."
              }
            },
            "centralLawName": {
              "type": "string",
              "metadata": {
                "description": "Central LAW name."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Region (unused — kept for consistency)."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource tags (unused — kept for consistency)."
              }
            },
            "workspaceReaderPrincipalId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "(Optional) Object ID of a user/group for the \"all-tables reader\" role. Leave empty to skip."
              }
            },
            "tableReaderPrincipalId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "(Optional) Object ID of a user/group for the table-restricted role. Leave empty to skip."
              }
            },
            "rowFilteredPrincipalId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "(Optional) Object ID of a user/group for the row-level filtered role. Leave empty to skip."
              }
            }
          },
          "variables": {
            "logAnalyticsReaderRoleId": "73c42c96-874c-492b-b04d-ab87d138a893",
            "tableCondition": "((!(ActionMatches{'Microsoft.OperationalInsights/workspaces/tables/data/read'})) OR (@Resource[Microsoft.OperationalInsights/workspaces/tables:name] StringEquals 'SecurityAudit_CL'))",
            "rowCondition": "((!(ActionMatches{'Microsoft.OperationalInsights/workspaces/tables/data/read'})) OR ((@Resource[Microsoft.OperationalInsights/workspaces/tables:name] StringEquals 'SecurityAudit_CL') AND (@Resource[Microsoft.OperationalInsights/workspaces/tables/record:Severity<$key_case_sensitive$>] StringEquals 'Critical')))"
          },
          "resources": [
            {
              "condition": "[not(empty(parameters('workspaceReaderPrincipalId')))]",
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.OperationalInsights/workspaces/{0}', parameters('centralLawName'))]",
              "name": "[guid(parameters('centralLawId'), variables('logAnalyticsReaderRoleId'), parameters('workspaceReaderPrincipalId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('logAnalyticsReaderRoleId'))]",
                "principalId": "[parameters('workspaceReaderPrincipalId')]",
                "principalType": "User"
              }
            },
            {
              "type": "Microsoft.Authorization/roleDefinitions",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, 'amlab-granular-log-reader')]",
              "properties": {
                "roleName": "[format('AMLAB - Granular Log Reader ({0})', uniqueString(resourceGroup().id))]",
                "description": "Granular RBAC role for Log Analytics. Assign with ABAC conditions to restrict table or row-level access. Uses DataAction for data plane control.",
                "type": "CustomRole",
                "permissions": [
                  {
                    "actions": [
                      "Microsoft.OperationalInsights/workspaces/read",
                      "Microsoft.OperationalInsights/workspaces/query/read"
                    ],
                    "notActions": [],
                    "dataActions": [
                      "Microsoft.OperationalInsights/workspaces/tables/data/read"
                    ],
                    "notDataActions": []
                  }
                ],
                "assignableScopes": [
                  "[resourceGroup().id]"
                ]
              }
            },
            {
              "condition": "[not(empty(parameters('tableReaderPrincipalId')))]",
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.OperationalInsights/workspaces/{0}', parameters('centralLawName'))]",
              "name": "[guid(parameters('centralLawId'), 'granular-table-reader', parameters('tableReaderPrincipalId'))]",
              "properties": {
                "roleDefinitionId": "[resourceId('Microsoft.Authorization/roleDefinitions', guid(resourceGroup().id, 'amlab-granular-log-reader'))]",
                "principalId": "[parameters('tableReaderPrincipalId')]",
                "principalType": "User",
                "condition": "[variables('tableCondition')]",
                "conditionVersion": "2.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Authorization/roleDefinitions', guid(resourceGroup().id, 'amlab-granular-log-reader'))]"
              ]
            },
            {
              "condition": "[not(empty(parameters('rowFilteredPrincipalId')))]",
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[format('Microsoft.OperationalInsights/workspaces/{0}', parameters('centralLawName'))]",
              "name": "[guid(parameters('centralLawId'), 'granular-row-filtered', parameters('rowFilteredPrincipalId'))]",
              "properties": {
                "roleDefinitionId": "[resourceId('Microsoft.Authorization/roleDefinitions', guid(resourceGroup().id, 'amlab-granular-log-reader'))]",
                "principalId": "[parameters('rowFilteredPrincipalId')]",
                "principalType": "User",
                "condition": "[variables('rowCondition')]",
                "conditionVersion": "2.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Authorization/roleDefinitions', guid(resourceGroup().id, 'amlab-granular-log-reader'))]"
              ]
            }
          ],
          "outputs": {
            "granularRoleName": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Authorization/roleDefinitions', guid(resourceGroup().id, 'amlab-granular-log-reader')), '2022-04-01').roleName]"
            },
            "rbacSummary": {
              "type": "string",
              "value": "Granular RBAC deployed: (1) workspace-level via Log Analytics Reader, (2) table-level via ABAC condition restricting to SecurityAudit_CL, (3) row-level via ABAC condition filtering Severity==Critical only. Custom role \"AMLAB - Granular Log Reader\" uses DataActions for data plane control."
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "security-posture-alerts",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "workspaceId": {
            "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('lawCentralName'))]"
          },
          "actionGroupId": {
            "value": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          },
          "tags": {
            "value": "[variables('commonTags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "15529012368281587446"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Region for scheduled query alerts."
              }
            },
            "workspaceId": {
              "type": "string",
              "metadata": {
                "description": "Central Log Analytics workspace resource ID."
              }
            },
            "actionGroupId": {
              "type": "string",
              "metadata": {
                "description": "Action group resource ID."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource tags."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Insights/scheduledQueryRules",
              "apiVersion": "2023-03-15-preview",
              "name": "alert-security-control-plane-drift",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "description": "Control-plane drift watch: unusual bursts of write/delete operations.",
                "enabled": true,
                "severity": 2,
                "scopes": [
                  "[parameters('workspaceId')]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT15M",
                "criteria": {
                  "allOf": [
                    {
                      "query": "AzureActivity | where TimeGenerated > ago(15m) | where ActivityStatusValue == \"Success\" | where OperationNameValue has_any (\"/write\", \"/delete\", \"/action\") | summarize Changes = count()",
                      "timeAggregation": "Count",
                      "operator": "GreaterThan",
                      "threshold": 40,
                      "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                      }
                    }
                  ]
                },
                "autoMitigate": true,
                "actions": {
                  "actionGroups": [
                    "[parameters('actionGroupId')]"
                  ]
                }
              }
            },
            {
              "type": "Microsoft.Insights/scheduledQueryRules",
              "apiVersion": "2023-03-15-preview",
              "name": "alert-security-privilege-escalation-watch",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "description": "Privilege escalation watch: high-risk RBAC mutations in activity logs.",
                "enabled": true,
                "severity": 1,
                "scopes": [
                  "[parameters('workspaceId')]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT30M",
                "criteria": {
                  "allOf": [
                    {
                      "query": "AzureActivity | where TimeGenerated > ago(30m) | where ActivityStatusValue == \"Success\" | where OperationNameValue has_any (\"roleAssignments/write\", \"roleDefinitions/write\", \"elevateAccess/action\") | summarize Hits = count()",
                      "timeAggregation": "Count",
                      "operator": "GreaterThan",
                      "threshold": 0,
                      "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                      }
                    }
                  ]
                },
                "autoMitigate": true,
                "actions": {
                  "actionGroups": [
                    "[parameters('actionGroupId')]"
                  ]
                }
              }
            },
            {
              "type": "Microsoft.Insights/scheduledQueryRules",
              "apiVersion": "2023-03-15-preview",
              "name": "alert-security-exfil-early-warning",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "description": "Exfiltration early warning: outbound traffic spikes in flow analytics.",
                "enabled": true,
                "severity": 2,
                "skipQueryValidation": true,
                "scopes": [
                  "[parameters('workspaceId')]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT30M",
                "criteria": {
                  "allOf": [
                    {
                      "query": "NTANetAnalytics | where TimeGenerated > ago(30m) | where SubType == \"FlowLog\" | where FlowDirection == \"O\" | summarize OutboundBytes = sum(BytesSrcToDest) | where OutboundBytes > 1000000000",
                      "timeAggregation": "Count",
                      "operator": "GreaterThan",
                      "threshold": 0,
                      "failingPeriods": {
                        "numberOfEvaluationPeriods": 1,
                        "minFailingPeriodsToAlert": 1
                      }
                    }
                  ]
                },
                "autoMitigate": true,
                "actions": {
                  "actionGroups": [
                    "[parameters('actionGroupId')]"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "security-workbook",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[guid(resourceGroup().id, variables('securityWorkbookName'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "centralLawId": {
            "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('lawCentralName'))]"
          },
          "tags": {
            "value": "[variables('commonTags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.37.4.10188",
              "templateHash": "8486905438972871987"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Workbook resource name (GUID)."
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Region for the workbook resource."
              }
            },
            "centralLawId": {
              "type": "string",
              "metadata": {
                "description": "Central Log Analytics workspace resource ID (sourceId for the workbook)."
              }
            },
            "tags": {
              "type": "object",
              "defaultValue": {},
              "metadata": {
                "description": "Resource tags."
              }
            }
          },
          "variables": {
            "tilesQuery": "let activity = AzureActivity | where TimeGenerated > ago(24h) | where ActivityStatusValue == \"Success\";\r\nlet writes      = toscalar(activity | where OperationNameValue has_any (\"/write\",\"/delete\",\"/action\") | summarize count());\r\nlet rbac        = toscalar(activity | where OperationNameValue has_any (\"roleAssignments/write\",\"roleDefinitions/write\",\"elevateAccess/action\") | summarize count());\r\nlet kvOps       = toscalar(AzureDiagnostics | where TimeGenerated > ago(24h) | where ResourceType == \"VAULTS\" | summarize count());\r\nlet ntaFlows    = toscalar(NTANetAnalytics | where TimeGenerated > ago(24h) | where SubType == \"FlowLog\" | summarize count());\r\nlet maliciousNw = toscalar(NTANetAnalytics | where TimeGenerated > ago(24h) | where SubType == \"FlowLog\" | where FlowType == \"MaliciousFlow\" or AclName has \"MaliciousFlow\" | summarize count());\r\nlet signins     = toscalar(union isfuzzy=true (SigninLogs | where TimeGenerated > ago(24h) | summarize count()), (print SignInsCount = 0 | project Count = SignInsCount) | summarize sum(Count));\r\nprint\r\n    ['Control-plane changes (24h)']  = writes,\r\n    ['RBAC / elevation events (24h)']= rbac,\r\n    ['Key Vault ops (24h)']          = kvOps,\r\n    ['Network flows (24h)']          = ntaFlows,\r\n    ['Malicious flow hits (24h)']    = maliciousNw,\r\n    ['Entra sign-ins (24h)']         = signins\r\n",
            "signinsTrendQuery": "SigninLogs\r\n| where TimeGenerated > ago(24h)\r\n| summarize Success = countif(ResultType == 0), Failed = countif(ResultType != 0) by bin(TimeGenerated, 1h)\r\n| render timechart\r\n",
            "signinsFailuresQuery": "SigninLogs\r\n| where TimeGenerated > ago(24h)\r\n| where ResultType != 0\r\n| summarize Failures = count() by ResultType = tostring(ResultType), Reason = tostring(ResultDescription)\r\n| top 10 by Failures desc\r\n",
            "signinsByLocationQuery": "SigninLogs\r\n| where TimeGenerated > ago(24h)\r\n| extend Country = tostring(LocationDetails.countryOrRegion)\r\n| where isnotempty(Country)\r\n| summarize SignIns = count() by Country\r\n| top 10 by SignIns desc\r\n",
            "signinsRiskyQuery": "SigninLogs\r\n| where TimeGenerated > ago(7d)\r\n| where RiskLevelDuringSignIn in (\"medium\",\"high\") or RiskLevelAggregated in (\"medium\",\"high\") or RiskState != \"none\"\r\n| project TimeGenerated, UserPrincipalName, AppDisplayName, IPAddress, RiskLevelDuringSignIn, RiskState, ResultDescription\r\n| order by TimeGenerated desc\r\n| take 50\r\n",
            "topOperationsQuery": "AzureActivity\r\n| where TimeGenerated > ago(24h)\r\n| where ActivityStatusValue == \"Success\"\r\n| where OperationNameValue has_any (\"/write\",\"/delete\",\"/action\")\r\n| summarize Count = count() by OperationName = tostring(OperationNameValue)\r\n| top 15 by Count desc\r\n",
            "topCallersQuery": "AzureActivity\r\n| where TimeGenerated > ago(24h)\r\n| where ActivityStatusValue == \"Success\"\r\n| where OperationNameValue has_any (\"/write\",\"/delete\",\"/action\")\r\n| summarize Changes = count() by Caller = iif(isempty(Caller), \"(system / managed identity)\", Caller)\r\n| top 15 by Changes desc\r\n",
            "writeDeleteTimelineQuery": "AzureActivity\r\n| where TimeGenerated > ago(24h)\r\n| where ActivityStatusValue == \"Success\"\r\n| extend Action = case(\r\n    OperationNameValue has \"/delete\", \"Delete\",\r\n    OperationNameValue has \"/write\", \"Write\",\r\n    OperationNameValue has \"/action\", \"Action\",\r\n    \"Other\")\r\n| where Action != \"Other\"\r\n| summarize Count = count() by bin(TimeGenerated, 30m), Action\r\n| render timechart\r\n",
            "failedOperationsQuery": "AzureActivity\r\n| where TimeGenerated > ago(24h)\r\n| where ActivityStatusValue in (\"Failed\",\"Failure\")\r\n| where OperationNameValue has_any (\"/write\",\"/delete\",\"/action\")\r\n| summarize Failures = count(), Operations = make_set(OperationNameValue, 5) by Caller = iif(isempty(Caller), \"(system / managed identity)\", Caller)\r\n| top 15 by Failures desc\r\n",
            "privEscQuery": "AzureActivity\r\n| where TimeGenerated > ago(7d)\r\n| where OperationNameValue has_any (\"roleAssignments/write\",\"roleDefinitions/write\",\"elevateAccess/action\")\r\n| project TimeGenerated, Caller, OperationName = tostring(OperationNameValue), Status = ActivityStatusValue, Resource = _ResourceId, CorrelationId\r\n| order by TimeGenerated desc\r\n| take 100\r\n",
            "privEscByCallerQuery": "AzureActivity\r\n| where TimeGenerated > ago(7d)\r\n| where OperationNameValue has_any (\"roleAssignments/write\",\"roleDefinitions/write\",\"elevateAccess/action\")\r\n| summarize Events = count() by Caller = iif(isempty(Caller), \"(system / managed identity)\", Caller)\r\n| top 10 by Events desc\r\n",
            "topEgressQuery": "NTANetAnalytics\r\n| where TimeGenerated > ago(24h)\r\n| where SubType == \"FlowLog\"\r\n| where FlowDirection == \"O\"\r\n| summarize OutboundBytes = sum(BytesSrcToDest), Flows = count() by DestIp\r\n| extend OutboundMB = round(todouble(OutboundBytes) / 1024 / 1024, 2)\r\n| top 15 by OutboundBytes desc\r\n| project DestIp, OutboundMB, Flows\r\n",
            "egressTimelineQuery": "NTANetAnalytics\r\n| where TimeGenerated > ago(24h)\r\n| where SubType == \"FlowLog\"\r\n| where FlowDirection == \"O\"\r\n| summarize OutboundMB = round(todouble(sum(BytesSrcToDest))/1024/1024, 2) by bin(TimeGenerated, 30m)\r\n| render timechart\r\n",
            "deniedFlowsQuery": "NTANetAnalytics\r\n| where TimeGenerated > ago(24h)\r\n| where SubType == \"FlowLog\"\r\n| where FlowStatus == \"D\"\r\n| summarize DeniedFlows = count() by SrcIp, DestIp, DestPort = tostring(DestPort), L7Protocol = tostring(L7Protocol)\r\n| top 20 by DeniedFlows desc\r\n",
            "maliciousFlowsQuery": "NTANetAnalytics\r\n| where TimeGenerated > ago(7d)\r\n| where SubType == \"FlowLog\"\r\n| where FlowType == \"MaliciousFlow\" or AclName has \"MaliciousFlow\"\r\n| project TimeGenerated, SrcIp, DestIp, DestPort, FlowDirection, FlowStatus, L7Protocol, BytesSrcToDest, AclName\r\n| order by TimeGenerated desc\r\n| take 50\r\n",
            "lifecycleByProviderQuery": "AzureActivity\r\n| where TimeGenerated > ago(7d)\r\n| where ActivityStatusValue == \"Success\"\r\n| where OperationNameValue has_any (\"/write\",\"/delete\")\r\n| extend Action = iif(OperationNameValue has \"/delete\", \"Delete\", \"Write\")\r\n| summarize Count = count() by ResourceProvider = tostring(ResourceProviderValue), Action\r\n| top 20 by Count desc\r\n",
            "lifecycleTimelineQuery": "AzureActivity\r\n| where TimeGenerated > ago(7d)\r\n| where ActivityStatusValue == \"Success\"\r\n| where OperationNameValue has_any (\"/write\",\"/delete\")\r\n| summarize Events = count() by bin(TimeGenerated, 1h), ResourceProvider = tostring(ResourceProviderValue)\r\n| render timechart\r\n",
            "keyVaultOpsQuery": "AzureDiagnostics\r\n| where TimeGenerated > ago(24h)\r\n| where ResourceType == \"VAULTS\"\r\n| summarize Count = count() by OperationName, ResultType, identity_claim_upn_s = tostring(identity_claim_upn_s)\r\n| top 25 by Count desc\r\n",
            "keyVaultFailuresQuery": "AzureDiagnostics\r\n| where TimeGenerated > ago(7d)\r\n| where ResourceType == \"VAULTS\"\r\n| where ResultType != \"Success\"\r\n| project TimeGenerated, Resource, OperationName, ResultType, ResultSignature, identity_claim_upn_s = tostring(identity_claim_upn_s), CallerIPAddress\r\n| order by TimeGenerated desc\r\n| take 50\r\n",
            "storageOpsQuery": "AzureDiagnostics\r\n| where TimeGenerated > ago(24h)\r\n| where ResourceProvider == \"MICROSOFT.STORAGE\"\r\n| summarize Count = count() by OperationName, statusText_s = tostring(statusText_s)\r\n| top 20 by Count desc\r\n",
            "linkedAlertsQuery": "AlertsManagementResources\r\n| where type == \"microsoft.alertsmanagement/alerts\"\r\n| extend ruleId = tostring(properties.essentials.alertRule)\r\n| extend ruleName = tostring(split(ruleId, \"/\")[-1])\r\n| where ruleName has_any (\r\n    \"alert-security-control-plane-drift\",\r\n    \"alert-security-privilege-escalation-watch\",\r\n    \"alert-security-exfil-early-warning\")\r\n| extend Severity = tostring(properties.essentials.severity), State = tostring(properties.essentials.alertState),\r\n         FiredTime = todatetime(properties.essentials.startDateTime)\r\n| project FiredTime, ruleName, Severity, State, MonitorCondition = tostring(properties.essentials.monitorCondition)\r\n| order by FiredTime desc\r\n| take 50\r\n",
            "workbookContent": {
              "version": "Notebook/1.0",
              "items": [
                {
                  "type": 1,
                  "content": {
                    "json": "## 🛡️ Security operations — single pane of glass\n\nThis workbook surfaces the most useful security telemetry from the Azure Monitor demo lab:\n\n* **Identity** — Entra sign-ins (success / failure / risky)\n* **Control plane** — Azure Resource Manager CRUD activity, top operations & callers\n* **Privilege escalation** — RBAC role assignments / definitions / elevateAccess\n* **Network** — egress hotspots, denied flows, malicious-flow hits (from VNet Flow Logs + Traffic Analytics)\n* **Lifecycle** — resource churn by provider\n* **Sensitive data plane** — Key Vault secret reads, Storage transactions\n* **Linked alerts** — fires from scenarios 47/48/49\n\n> Time scope defaults to 24h for tiles, 7d for higher-signal panels (privilege escalation, malicious flows). All queries are pinned to the central lab workspace."
                  },
                  "name": "header"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "[variables('tilesQuery')]",
                    "size": 3,
                    "title": "Last 24 hours — security snapshot",
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "visualization": "tiles",
                    "tileSettings": {
                      "showBorder": true,
                      "titleContent": {
                        "columnMatch": "Column1"
                      },
                      "leftContent": {
                        "columnMatch": "Column2",
                        "formatter": 12
                      }
                    }
                  },
