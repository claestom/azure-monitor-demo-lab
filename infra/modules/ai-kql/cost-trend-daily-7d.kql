// Estimated cost trend, per day (last 7 days)
// -------------------------------------------------------------------
// Purpose:  Daily spend trend for the FinOps demo — total tokens, calls
//           and estimated USD per day across all agents. Use it to spot
//           day-over-day growth or spikes and to seed a budget threshold.
// Source:   Application Insights `dependencies` table (GenAI spans).
// Filter:   isnotempty(gen_ai.agent.name) — attributable spans only.
// Pricing:  gpt-5-mini GlobalStandard list price (input $0.25/1M,
//           output $2.00/1M). Replace with your current per-model rates.
// Caveat:   Token-derived ESTIMATE — excludes discounts/PTU/cached input;
//           reconcile with Azure Cost Management. Widen ago(7d) as needed.

dependencies
| where timestamp > ago(7d)
      and isnotempty(tostring(customDimensions["gen_ai.agent.name"]))
| extend inTok  = toint(customDimensions["gen_ai.usage.input_tokens"]),
         outTok = toint(customDimensions["gen_ai.usage.output_tokens"])
| summarize prompt=sum(inTok), completion=sum(outTok), calls=count()
          by day=bin(timestamp, 1d)
| extend est_usd = round(prompt/1000000.0*0.25 + completion/1000000.0*2.00, 4)
| order by day asc
