{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure Monitor Demo Lab — central per-user config",
  "description": "Copy this file to lab.config.json (gitignored) and fill in real values. Then run scripts/sync-config.ps1 (or scripts/deploy.ps1, which calls it for you) to materialize .azure-target.json, infra/main.parameters.json and terraform/stages.tfvars from these values. This is the ONE place you need to edit when bootstrapping the lab.",

  "subscriptionId":   "<YOUR-SUBSCRIPTION-ID>",
  "subscriptionName": "<YOUR-SUBSCRIPTION-NAME>",
  "tenantId":         "<YOUR-TENANT-ID>",

  "alertEmail":       "your.alias@example.com",
  "vmAdminPassword":  "<STRONG-PASSWORD>",

  "resourceGroup":    "rg-azure-monitor-lab",
  "location":         "northeurope",
  "namePrefix":       "amlab",
  "vmAdminUsername":  "azureuser",
  "dailyCapGb":       1,
  "aksNodeCount":     2,
  "deployWindowsVm":  true,
  "deployLinuxVm":    true,

  "siemWebhookUrl":   "",
  "forbiddenSubscriptionIds": [],

  "stageToggles": {
    "enableStageA": true,
    "enableStageB": true,
    "enableStageC": true,
    "enableStageD": true,
    "enableStageE": true
  }
}
