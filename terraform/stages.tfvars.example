# Copy this file to stages.tfvars and fill in real values.
# stages.tfvars is gitignored (it contains the VM admin password).
#
# Usage:
#   cp stages.tfvars.example stages.tfvars
#   # edit stages.tfvars, then:
#   terraform plan  -var-file stages.tfvars
#   terraform apply -var-file stages.tfvars

subscription_id     = "00000000-0000-0000-0000-000000000000"

# Resource group is BYO (bring-your-own). Create it BEFORE running terraform apply:
#   az group create -n <resource_group_name> -l <location>
# Terraform looks the RG up via data source and only manages resources INSIDE it.
# `terraform destroy` will NOT delete the RG itself.
# If you omit resource_group_name, the default "rg-azure-monitor-lab" is used.
resource_group_name = "rg-azure-monitor-lab"

location            = "swedencentral"
alert_email         = "your.alias@example.com"
vm_admin_password   = "<STRONG-PASSWORD>"

# Stage toggles - enable one at a time the first time through, then flip the
# next one and re-run plan/apply. Each new stage adds exactly one
# azapi_resource.stage_* to the plan.
enable_stage_a = true   # Foundation (LAW, DCR, AMW, Grafana, App Insights, workbooks)
enable_stage_b = false  # Workloads (App Service, AKS, VMs, VMSS, Connection Monitor)
enable_stage_c = false  # Alerting (metric/log/health alerts, action groups, AMBA, Prom rules)
enable_stage_d = false  # Security posture (Sentinel, custom logs, exfil early warning)
enable_stage_e = false  # Optional advanced (auto-mitigation Logic App, availability test, etc.)
